---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { locations } from '../../../../data/locations';
import { categories } from '../../../../data/categories';
import { getMoneyPageContent } from '../../../../data/money-page-content';
import HeroImage from '../../../../components/shared/HeroImage.astro';
import BreadcrumbListJsonLd from '../../../../components/seo/BreadcrumbListJsonLd.astro';
import FAQPageJsonLd from '../../../../components/seo/FAQPageJsonLd.astro';

export async function getStaticPaths() {
  const paths = [];
  
  for (const loc of locations) {
    for (const cat of categories) {
      paths.push({
        params: { location: loc.slug, category: cat.slug },
        props: { loc, cat },
      });
    }
  }
  
  return paths;
}

const { loc, cat } = Astro.props;
const content = getMoneyPageContent(loc.slug, cat.slug);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations/' },
  { name: loc.name, url: `/locations/${loc.slug}/` },
  { name: cat.name },
];

const faqTitle1 = `How do I find a ${cat.nameEs.toLowerCase()} in ${loc.name}?`;
const faqAnswer1 = content?.faq ?? `Use our directory to browse ${cat.name.toLowerCase()} services in ${loc.name}. Each listing includes contact information, service details, and location-specific information to help you make the right choice.`;

const faqTitle2 = `What types of properties are available in ${loc.name}?`;
const faqAnswer2 = `${loc.name} offers a variety of property types, including beachfront condos, mountain villas, residential homes, and commercial properties. The market caters to different budgets and investment goals.`;

const faqTitle3 = `Is ${loc.name} a good place for real estate investment?`;
const faqAnswer3 = `Yes, ${loc.name} is part of Samana province, one of the fastest-growing real estate markets in the Dominican Republic. The area attracts international investors and offers strong potential for appreciation and rental income.`;

const otherCategoriesInLocation = categories.filter((c) => c.slug !== cat.slug);
const otherLocationsForCategory = locations.filter((l) => l.slug !== loc.slug);
---

<BaseLayout
  title={`${cat.name} in ${loc.name}, Samana — Samana Real Estate Hub`}
  description={`Find ${cat.name.toLowerCase()} services in ${loc.name}, Samana province. ${content?.intro ? content.intro.slice(0, 120) + '...' : `Connect with professional ${cat.name.toLowerCase()} services for your real estate needs.`}`}
  canonical={`/locations/${loc.slug}/${cat.slug}/`}
  keywords={[cat.name, loc.name, 'real estate', 'Samana', 'Dominican Republic', cat.nameEs]}
>
  <BreadcrumbListJsonLd items={breadcrumbs} />
  <FAQPageJsonLd faqs={[
    { q: faqTitle1, a: faqAnswer1 },
    { q: faqTitle2, a: faqAnswer2 },
    { q: faqTitle3, a: faqAnswer3 },
  ]} />

  <HeroImage
    image={`/images/locations/${loc.slug}.jpg`}
    alt={`${cat.name} in ${loc.name}, Samana`}
    height="sm"
    overlay="dark"
    eyebrow={`${cat.classificationEn} · ${loc.name}`}
  >
    <Fragment slot="breadcrumbs">
      {breadcrumbs.map((crumb, i) => (
        <span class="flex items-center gap-1.5">
          {i > 0 && <span>/</span>}
          {crumb.url ? (
            <a href={crumb.url} class="hover:text-white/90 transition-colors">{crumb.name}</a>
          ) : (
            <span class="text-white/90">{crumb.name}</span>
          )}
        </span>
      ))}
    </Fragment>
    <Fragment slot="title">{cat.name} in {loc.name}</Fragment>
    <Fragment slot="subtitle">
      {content?.intro ?? `Find professional ${cat.name.toLowerCase()} services in ${loc.name}, Samana province. ${cat.tagline}`}
    </Fragment>
  </HeroImage>

  <section class="container-x py-16 md:py-24">
    {/* Map */}
    <div class="mx-auto mt-10 overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-card">
      <div id="map" class="h-[300px] w-full md:h-[350px]" data-lat={loc.lat} data-lng={loc.lng} data-zoom={loc.zoom} data-name={loc.name}></div>
    </div>

    {/* Main content */}
    <div class="mx-auto mt-14 grid gap-8 lg:grid-cols-3">
      {/* Left column - Content */}
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
          {cat.name} services in {loc.name}
        </h2>
        <div class="mt-4 prose-content">
          <p>
            <strong>{loc.name}</strong> is a {loc.typeEn.toLowerCase()} in the {loc.municipality} municipality of 
            Samana province, Dominican Republic. {content?.intro ?? cat.description}
          </p>
          
          {content?.market && (
            <h3>The market in {loc.name}</h3>
            <p>{content.market}</p>
          )}
          
          <h3>Why choose {cat.name.toLowerCase()} services in {loc.name}?</h3>
          <p>
            {loc.name} has a growing real estate market with increasing demand for professional 
            {' '}{cat.name.toLowerCase()} services. Whether you're buying, selling, renting, or investing, 
            having a qualified {cat.nameEs.toLowerCase()} in {loc.name} can make all the difference.
          </p>
          
          <h3>Real estate in {loc.name}</h3>
          <p>
            The real estate market in {loc.name} offers diverse opportunities, from beachfront properties 
            to mountain retreats. As part of Samana province, it benefits from the region's natural beauty, 
            growing tourism infrastructure, and international recognition as a premium destination.
          </p>
          
          <h3>Connect with professionals</h3>
          <p>
            Our directory connects you with qualified {cat.name.toLowerCase()} professionals in {loc.name}. 
            Browse our listings to find the right partner for your real estate journey.
          </p>
        </div>

        {/* Featured listings placeholder */}
        <div class="mt-10">
          <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
            Featured {cat.name.toLowerCase()} listings in {loc.name}
          </h2>
          <div class="mt-6 space-y-4">
            {[1, 2, 3].map((i) => (
              <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
                <div class="flex items-start gap-4">
                  <div class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-lg font-bold text-ink">
                        {cat.name} — {loc.name}
                      </h3>
                      <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-[11px] font-semibold text-accent">Featured</span>
                    </div>
                    <p class="mt-1 text-sm text-ink/60">
                      Professional {cat.name.toLowerCase()} services in {loc.name}, Samana province.
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2 text-xs text-ink/40">
                      <span class="inline-flex items-center gap-1 rounded-full bg-ink/5 px-2.5 py-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z" /><circle cx="12" cy="10" r="3" /></svg>
                        {loc.name}
                      </span>
                      <span class="inline-flex items-center gap-1 rounded-full bg-ink/5 px-2.5 py-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        Contact for details
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
            <div class="rounded-2xl border-2 border-dashed border-ink/10 bg-paper p-8 text-center">
              <p class="text-sm text-ink/40">
                Your business could be listed here. <a href="/about/" class="font-semibold text-brand hover:underline">Get your free listing →</a>
              </p>
            </div>
          </div>
        </div>

        {/* FAQs */}
        <div class="mt-10">
          <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
            Frequently asked questions
          </h2>
          <div class="mt-6 space-y-4">
            <details class="group rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
              <summary class="cursor-pointer font-display text-lg font-bold text-ink group-open:text-brand">
                {faqTitle1}
              </summary>
              <p class="mt-3 text-ink/70">{faqAnswer1}</p>
            </details>
            
            <details class="group rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
              <summary class="cursor-pointer font-display text-lg font-bold text-ink group-open:text-brand">
                {faqTitle2}
              </summary>
              <p class="mt-3 text-ink/70">{faqAnswer2}</p>
            </details>
            
            <details class="group rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
              <summary class="cursor-pointer font-display text-lg font-bold text-ink group-open:text-brand">
                {faqTitle3}
              </summary>
              <p class="mt-3 text-ink/70">{faqAnswer3}</p>
            </details>
          </div>
        </div>

        {/* Related services - internal linking */}
        <div class="mt-10">
          <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
            Related services in {loc.name}
          </h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {otherCategoriesInLocation.slice(0, 4).map((c) => (
              <a
                href={`/locations/${loc.slug}/${c.slug}/`}
                class="flex items-center gap-3 rounded-2xl border border-ink/10 bg-white p-4 shadow-card transition-all hover:border-brand/20 hover:shadow-lg"
              >
                <div class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-soft text-brand">
                  <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden>
                    <path d="M3 7h8m-3-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div>
                  <span class="text-sm font-medium text-ink group-hover:text-brand">{c.name}</span>
                  <span class="block text-xs text-ink/45">{c.classificationEn}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* Right column - Sidebar */}
      <div class="space-y-6">
        {/* CTA */}
        <div class="rounded-2xl border border-ink/10 bg-accent-soft p-6">
          <h3 class="font-display text-lg font-bold text-ink">
            List your business
          </h3>
          <p class="mt-2 text-sm text-ink/70">
            Get discovered by potential clients searching for {cat.name.toLowerCase()} services in {loc.name}.
          </p>
          <a
            href="/about/"
            class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-brand-ink transition-all hover:bg-accent/90"
          >
            Get listed
          </a>
        </div>

        {/* Other categories in this location */}
        <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
          <h3 class="font-display text-lg font-bold text-ink">
            Other services in {loc.name}
          </h3>
          <ul class="mt-4 space-y-2">
            {otherCategoriesInLocation.map((c) => (
              <li>
                <a
                  href={`/locations/${loc.slug}/${c.slug}/`}
                  class="flex items-center gap-2 text-sm text-ink/70 hover:text-brand"
                >
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden>
                    <path d="M3 7h8m-3-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* Other locations for this category */}
        <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
          <h3 class="font-display text-lg font-bold text-ink">
            {cat.name} in other locations
          </h3>
          <ul class="mt-4 space-y-2">
            {otherLocationsForCategory.map((l) => (
              <li>
                <a
                  href={`/locations/${l.slug}/${cat.slug}/`}
                  class="flex items-center gap-2 text-sm text-ink/70 hover:text-brand"
                >
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden>
                    <path d="M3 7h8m-3-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {l.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Leaflet CSS + JS */}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  {/* Leaflet init */}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mapEl = document.getElementById('map');
      if (!mapEl) return;

      const lat = parseFloat(mapEl.dataset.lat || '19.2053');
      const lng = parseFloat(mapEl.dataset.lng || '-69.3126');
      const zoom = parseInt(mapEl.dataset.zoom || '13');

      // @ts-ignore
      const L = window.L;
      if (!L) return;

      const map = L.map('map').setView([lat, lng], zoom);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      const icon = L.divIcon({
        className: 'custom-marker',
        html: '<div style="width:24px;height:24px;background:#1E3A5F;border:3px solid #C9A84C;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.3);"></div>',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        popupAnchor: [0, -16],
      });

      L.marker([lat, lng], { icon }).addTo(map)
        .bindPopup('<strong>' + mapEl.dataset.name + '</strong><br>Samana, Dominican Republic')
        .openPopup();
    });
  </script>
</BaseLayout>
