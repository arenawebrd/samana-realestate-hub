---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categories, getCategoryBySlug } from '../../../data/categories';
import { locations } from '../../../data/locations';
import HeroImage from '../../../components/shared/HeroImage.astro';
import BreadcrumbListJsonLd from '../../../components/seo/BreadcrumbListJsonLd.astro';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/categories/' },
  { name: cat.name },
];
---

<BaseLayout
  title={`${cat.name} in Samana — Samana Real Estate Hub`}
  description={`Find ${cat.name.toLowerCase()} services across Samana province. Browse ${locations.length} locations with ${cat.name.toLowerCase()} professionals ready to help.`}
  canonical={`/categories/${cat.slug}/`}
  keywords={[cat.name, 'real estate', 'Samana', 'Dominican Republic', cat.nameEs]}
>
  <BreadcrumbListJsonLd items={breadcrumbs} />

  <HeroImage
    image={`/images/categories/${cat.slug}.jpg`}
    alt={`${cat.name} services in Samana`}
    height="md"
    overlay="dark"
    eyebrow={cat.classificationEn}
  >
    <Fragment slot="breadcrumbs">
      <a href="/" class="hover:text-white/90 transition-colors">Home</a>
      <span>/</span>
      <a href="/categories/" class="hover:text-white/90 transition-colors">Categories</a>
      <span>/</span>
      <span class="text-white/90">{cat.name}</span>
    </Fragment>
    <Fragment slot="title">{cat.name}</Fragment>
    <Fragment slot="subtitle">{cat.description}</Fragment>
  </HeroImage>

  <section class="container-x py-16 md:py-24">
    {/* About this category */}
    <div class="mx-auto mt-10">
      <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
        About {cat.name}
      </h2>
      <div class="mt-4 prose-content">
        <p>
          <strong>{cat.name}</strong> ({cat.nameEs}) falls under the classification of <em>{cat.classificationEn}</em>. 
          {cat.description}
        </p>
        <p>
          In Samana province, {cat.name.toLowerCase()} services are available across {locations.length} locations. 
          Whether you're in the bustling center of Santa Barbara de Samana or the tranquil beaches of Las Galeras, 
          you can find qualified professionals to help with your real estate needs.
        </p>
        <p>
          Use our directory to find and connect with {cat.name.toLowerCase()} services in your area. 
          Each listing includes contact information, service details, and location-specific information 
          to help you make the right choice.
        </p>
      </div>
    </div>

    {/* Locations with this category */}
    <div class="mx-auto mt-14">
      <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
        {cat.name} in {locations.length} locations
      </h2>
      <p class="mt-2 text-ink/60">
        Find {cat.name.toLowerCase()} services across Samana province.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {locations.map((loc) => (
          <a
            href={`/locations/${loc.slug}/${cat.slug}/`}
            class="group flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-5 shadow-card transition-all hover:border-accent/30 hover:shadow-xl"
          >
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-brand-soft text-brand">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden>
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="2" fill="none"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2" fill="none"/>
              </svg>
            </div>
            <div>
              <span class="font-medium text-ink group-hover:text-brand">{loc.name}</span>
              <span class="block text-xs text-ink/50">{loc.typeEn}</span>
            </div>
            <div class="ml-auto grid h-8 w-8 place-items-center rounded-full text-ink/30 transition-colors group-hover:bg-brand-soft group-hover:text-brand">
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden>
                <path d="M3 7h8m-3-4 4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* CTA */}
    <div id="contact" class="mt-12">
      <div class="relative overflow-hidden rounded-3xl border border-ink/10 bg-paper p-10 md:p-16">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(600px_300px_at_80%_10%,rgba(30,58,95,0.08),transparent_60%)]"
        />
        <div class="relative grid grid-cols-1 items-center gap-8 md:grid-cols-12">
          <div class="md:col-span-7">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/60">
              List your {cat.nameEs.toLowerCase()}
            </div>
            <h2 class="mt-3 font-display text-3xl font-bold leading-[1.05] tracking-tightest md:text-5xl">
              Get discovered by potential clients
            </h2>
            <p class="mt-4 max-w-xl text-ink/70">
              Join our directory and connect with buyers, sellers, and investors searching for 
              {cat.name.toLowerCase()} services in Samana province.
            </p>
          </div>

          <div class="flex flex-col items-start gap-3 md:col-span-5 md:items-end">
            <a
              href="/about/"
              class="group inline-flex items-center gap-3 rounded-full bg-accent px-6 py-4 text-brand-ink transition-all hover:bg-accent/90"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 4v16m8-8H4"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="font-display text-xl font-bold">List your business</span>
            </a>
            <a
              href="/categories/"
              class="text-sm font-medium text-ink/70 underline-offset-4 hover:text-ink hover:underline"
            >
              or explore other categories →
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Other categories */}
    <section class="container-x mt-16">
      <h2 class="font-display text-2xl font-bold tracking-tightest md:text-3xl">
        Other real estate categories
      </h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {categories.filter((c) => c.slug !== cat.slug).map((c) => (
          <a
            href={`/categories/${c.slug}/`}
            class="rounded-full border border-ink/10 bg-white px-4 py-2 text-sm font-medium text-ink/80 shadow-card transition-all hover:border-accent/30 hover:text-brand"
          >
            {c.name}
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
