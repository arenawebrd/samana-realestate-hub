---
const testimonials = [
  {
    quote: "Found the perfect vacation rental property in Las Terrenas through this directory. The agent we connected with understood exactly what we were looking for.",
    author: "Michael S.",
    location: "New York, USA",
    type: "Buyer",
  },
  {
    quote: "As a property owner in Samana, listing on this directory brought us consistent inquiries from serious renters. The visibility is exactly what we needed.",
    author: "Ana R.",
    location: "Samaná, DR",
    type: "Property Owner",
  },
  {
    quote: "The directory made it easy to compare real estate agencies in Las Terrenas. We ultimately chose one that helped us close on our beachfront condo.",
    author: "Pierre D.",
    location: "Paris, France",
    type: "Investor",
  },
];
---

<section class="container-x mt-24 md:mt-32">
  <div class="text-center">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/40">Testimonials</div>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tightest md:text-4xl">
      Trusted by buyers and property owners
    </h2>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {testimonials.map((t) => (
      <div class="rounded-2xl border border-ink/10 bg-white p-8 shadow-card">
        {/* Stars */}
        <div class="flex gap-1 text-accent">
          {[1,2,3,4,5].map(() => (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
          ))}
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink/70">"{t.quote}"</p>
        <div class="mt-6 flex items-center gap-3">
          <div class="grid h-9 w-9 place-items-center rounded-full bg-brand-soft text-xs font-bold text-brand">
            {t.author.charAt(0)}
          </div>
          <div>
            <div class="text-sm font-semibold text-ink">{t.author}</div>
            <div class="text-xs text-ink/50">{t.location} · {t.type}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
