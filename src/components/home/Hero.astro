---
import { business } from '../../data/business';
import { locations } from '../../data/locations';
import HeroImage from '../shared/HeroImage.astro';
---

<HeroImage
  image="/images/home/hero.jpg"
  alt="Beautiful beach in Samana, Dominican Republic"
  height="lg"
  overlay="dark"
>
  <Fragment slot="title">
    Find your perfect{" "}
    <span class="inline-flex items-center">
      <svg
        aria-hidden="true"
        viewBox="0 0 64 48"
        class="mx-1 inline-block h-[0.85em] w-auto -translate-y-1 md:mx-2"
      >
        <rect x="2" y="8" width="60" height="32" rx="6" fill="rgba(255,255,255,0.2)" />
        <rect x="10" y="16" width="20" height="16" rx="2" fill="rgba(255,255,255,0.3)" />
        <circle cx="44" cy="24" r="5" fill="#C9A84C" />
        <circle cx="56" cy="24" r="2.5" fill="#C9A84C" />
      </svg>
      property
    </span>
    <br />
    in Samana
  </Fragment>
  
  <Fragment slot="subtitle">
    The leading real estate directory in Samana province, Dominican Republic. 
    Connect with agencies, agents, developers, and property services across {locations.length} locations.
  </Fragment>
  
  <Fragment slot="actions">
    <div class="flex flex-col items-center gap-4">
      <div class="w-full max-w-2xl rounded-2xl border border-white/20 bg-white/10 p-2 shadow-card backdrop-blur-sm md:mt-4">
        <div class="flex flex-col items-stretch gap-2 md:flex-row md:items-center">
          <div class="flex items-center gap-2 rounded-xl px-4 py-3 md:w-48 md:border-r md:border-white/20">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 14s5-4.5 5-8a5 5 0 1 0-10 0c0 3.5 5 8 5 8Z" stroke="white" stroke-width="1.5" />
              <circle cx="8" cy="6" r="2" stroke="white" stroke-width="1.5" />
            </svg>
            <span class="text-sm font-semibold text-white">Samana, DR</span>
          </div>
          <div class="flex-1 px-4 py-3 text-left text-sm text-white/70">
            What are you looking for?
          </div>
          <a href="/locations/" class="btn-accent w-full md:w-auto">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.5" />
              <path d="M9 9l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            Explore locations
          </a>
        </div>
      </div>

      <div class="mt-2 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-white/80">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8l3 3 7-7" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {locations.length} locations covered
        </div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8l3 3 7-7" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          10 service categories
        </div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8l3 3 7-7" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Free directory listing
        </div>
      </div>
    </div>
  </Fragment>
</HeroImage>
