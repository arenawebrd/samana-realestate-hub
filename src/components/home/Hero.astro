---
import { locations } from '../../data/locations';
import { categories } from '../../data/categories';
---

<section class="relative min-h-[85vh] overflow-hidden md:min-h-screen">
  {/* Background image — full bleed, no heavy overlay */}
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-105"
    style="background-image: url('/images/home/hero.jpg');"
    role="img"
    aria-label="Samana coastline"
  />
  
  {/* Light transparent gradient — just enough for text readability */}
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/50" />
  
  {/* Bottom fade into page */}
  <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-paper to-transparent" />

  {/* Content */}
  <div class="container-x relative flex h-full min-h-[85vh] flex-col items-center justify-center py-20 text-center md:min-h-screen">
    {/* Eyebrow */}
    <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-white/90 backdrop-blur-md">
      <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" />
      Samana's real estate directory
    </div>

    {/* Title */}
    <h1 class="mt-6 max-w-4xl font-display text-5xl font-bold leading-[1.05] tracking-tightest text-white md:text-7xl lg:text-8xl">
      Find your perfect
      <span class="relative inline-block">
        <span class="relative z-10 text-accent"> property</span>
        <svg class="absolute -bottom-1 left-0 z-0 h-3 w-full text-accent/30" viewBox="0 0 200 12" preserveAspectRatio="none">
          <path d="M0,8 Q50,0 100,8 T200,8" stroke="currentColor" stroke-width="4" fill="none" />
        </svg>
      </span>
      <br />
      in Samana
    </h1>

    {/* Subtitle */}
    <p class="mt-6 max-w-2xl text-lg text-white/75 md:text-xl">
      The leading real estate directory in Samana province. Connect with agencies, agents, developers, and property services across <strong class="text-white">{locations.length} locations</strong>.
    </p>

    {/* Search bar */}
    <div class="mt-10 w-full max-w-2xl">
      <div class="flex flex-col items-stretch gap-3 rounded-2xl border border-white/15 bg-white/10 p-2 backdrop-blur-xl sm:flex-row sm:items-center">
        <div class="flex items-center gap-3 rounded-xl bg-white/10 px-5 py-3.5 sm:w-52">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span class="text-sm font-medium text-white">Samana, DR</span>
        </div>
        <div class="flex-1 px-4 py-3 text-sm text-white/50">
          What service do you need?
        </div>
        <a href="/locations/" class="btn-accent !px-6 !py-3.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          Search
        </a>
      </div>
    </div>

    {/* Quick category pills */}
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
      {categories.slice(0, 5).map((cat) => (
        <a
          href={`/categories/${cat.slug}/`}
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-medium text-white/70 backdrop-blur-sm transition-all hover:border-accent/40 hover:bg-accent/10 hover:text-white"
        >
          {cat.name}
        </a>
      ))}
      <a href="/categories/" class="rounded-full border border-white/10 px-4 py-2 text-xs font-medium text-white/50 transition-all hover:text-white/80">
        +{categories.length - 5} more
      </a>
    </div>

    {/* Trust badges */}
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/60">
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        {locations.length} locations covered
      </div>
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        {categories.length} service categories
      </div>
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        Free business listing
      </div>
    </div>
  </div>
</section>
