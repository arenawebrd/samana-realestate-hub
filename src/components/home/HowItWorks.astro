---
const steps = [
  {
    number: '01',
    title: 'Search by location',
    description: 'Browse our directory of 7 locations across Samana province. Find the area that matches your real estate goals.',
    icon: '<path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z" /><circle cx="12" cy="10" r="3" />',
  },
  {
    number: '02',
    title: 'Choose a category',
    description: 'Select from 10 real estate service categories — agencies, agents, developers, property managers, and more.',
    icon: '<rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />',
  },
  {
    number: '03',
    title: 'Connect with professionals',
    description: 'Browse listings, compare services, and reach out directly to the professionals that fit your needs.',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />',
  },
];
---

<section class="container-x mt-24 md:mt-32">
  <div class="text-center">
    <div class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/40">How it works</div>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tightest md:text-4xl">
      Find the right real estate professional
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-ink/60">
      Three simple steps to connect with trusted real estate services in Samana.
    </p>
  </div>

  <div class="mt-12 grid gap-8 md:grid-cols-3">
    {steps.map((step) => (
      <div class="relative rounded-2xl border border-ink/10 bg-white p-8 shadow-card">
        <div class="flex items-center gap-4">
          <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
          </div>
          <div class="font-display text-4xl font-bold text-ink/10">{step.number}</div>
        </div>
        <h3 class="mt-5 font-display text-lg font-bold text-ink">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/60">{step.description}</p>
      </div>
    ))}
  </div>
</section>
