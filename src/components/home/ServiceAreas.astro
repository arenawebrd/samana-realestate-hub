---
import { locations } from '../../data/locations';
---

<section class="container-x mt-24 md:mt-32">
  <div class="overflow-hidden rounded-3xl bg-ink p-10 text-paper md:p-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-paper/60">
          Coverage area
        </div>
        <h2 class="mt-3 font-display text-3xl font-bold leading-[1.05] tracking-tightest md:text-5xl">
          Samana province. <br />
          <span class="text-accent">Real estate across {locations.length} locations.</span>
        </h2>
        <p class="mt-5 max-w-xl text-paper/70">
          From the bustling streets of Santa Barbara de Samana to the pristine beaches of Las Galeras, 
          our directory covers every corner of the Samana peninsula.
        </p>
      </div>

      <div class="md:col-span-5">
        <ul class="flex flex-wrap gap-2">
          {locations.map((loc) => (
            <li>
              <a
                href={`/locations/${loc.slug}/`}
                class="inline-block rounded-full border border-paper/15 bg-paper/5 px-4 py-2 text-sm text-paper/90 backdrop-blur transition-all hover:border-accent/40 hover:text-accent"
              >
                {loc.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-paper/50">
          Each location has its own page with local real estate services and information.
        </p>
      </div>
    </div>
  </div>
</section>
