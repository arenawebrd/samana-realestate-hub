---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;

const data = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
