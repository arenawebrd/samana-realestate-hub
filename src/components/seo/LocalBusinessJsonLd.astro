---
import { business } from '../../data/business';
import { locations } from '../../data/locations';
import { categories } from '../../data/categories';

const data = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: business.name,
  description: business.description,
  url: business.siteUrl,
  publisher: {
    '@type': 'Organization',
    name: business.name,
    url: business.siteUrl,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Real estate services in Samana',
    numberOfItems: locations.length * categories.length,
    itemListElement: locations.slice(0, 3).map((loc) => ({
      '@type': 'ListItem',
      position: locations.indexOf(loc) + 1,
      item: {
        '@type': 'WebPage',
        name: `${loc.name} real estate`,
        url: `${business.siteUrl}/locations/${loc.slug}/`,
      },
    })),
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
